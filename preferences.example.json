{
  "schema_version": 1,
  "scope": "project",
  "display": {
    "group_cues": ["color", "text", "shape", "pattern"],
    "surface_intensity": "subdued",
    "contrast": "standard",
    "text_scale": 1.125,
    "line_height": 1.6,
    "accessibility_theme_override": null
  },
  "layout": {
    "density": "comfortable",
    "view": "overview",
